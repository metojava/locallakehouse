# Copy this file to .env in the repository root to override backend defaults.

# Where the lakehouse lives. Defaults to <repo>/data_warehouse.
# LAKEHOUSE_WAREHOUSE_DIR=C:/lakehouse/data_warehouse

# Embedded Derby Hive metastore (keeps Delta databases/tables across restarts).
# Defaults to <repo>/.spark_metastore.
# LAKEHOUSE_SPARK_METASTORE_DIR=C:/lakehouse/.spark_metastore

# Spark
# LAKEHOUSE_SPARK_MASTER=local[*]
# LAKEHOUSE_SPARK_DRIVER_MEMORY=2g
# LAKEHOUSE_SPARK_LOG_LEVEL=WARN

# Optional external Apache Spark installation. Must match the PySpark client
# (same major.minor, currently 4.1.x, Scala 2.13) or the session will refuse to
# start. Leave unset to use the Spark bundled with the PySpark wheel. You can
# also set this from the UI (Spark Settings), which persists to
# <repo>/.runtime_settings.json and takes precedence over this variable.
# LAKEHOUSE_SPARK_HOME=C:/spark/spark-4.1.4-bin-hadoop3
# Where "Download & install Spark" extracts releases. Defaults to <repo>/.spark_dist.
# LAKEHOUSE_SPARK_DIST_DIR=C:/lakehouse/.spark_dist

# Connector jars resolved from Maven Central on first run.
# Delta 4.3.1 is built against Spark 4.1.0; Iceberg 1.12.0 publishes a 4.1 runtime.
# LAKEHOUSE_DELTA_PACKAGE=io.delta:delta-spark_2.13:4.3.1
# LAKEHOUSE_ICEBERG_PACKAGE=org.apache.iceberg:iceberg-spark-runtime-4.1_2.13:1.12.0
# LAKEHOUSE_AVRO_PACKAGE=org.apache.spark:spark-avro_2.13:4.1.4
# LAKEHOUSE_JDBC_MYSQL_PACKAGE=com.mysql:mysql-connector-j:8.4.0
# LAKEHOUSE_JDBC_POSTGRES_PACKAGE=org.postgresql:postgresql:42.7.3
# LAKEHOUSE_JDBC_SQLSERVER_PACKAGE=com.microsoft.sqlserver:mssql-jdbc:12.6.1.jre11

# Offline mode: point at pre-downloaded jars and disable package resolution.
# LAKEHOUSE_SPARK_JARS=C:/jars/delta-spark_2.13-4.3.1.jar,C:/jars/iceberg-spark-runtime-4.1_2.13-1.12.0.jar,C:/jars/spark-avro_2.13-4.1.4.jar,C:/jars/mysql-connector-j-8.4.0.jar,C:/jars/postgresql-42.7.3.jar,C:/jars/mssql-jdbc-12.6.1.jre11.jar
# LAKEHOUSE_DELTA_PACKAGE=
# LAKEHOUSE_ICEBERG_PACKAGE=
# LAKEHOUSE_AVRO_PACKAGE=
# LAKEHOUSE_JDBC_MYSQL_PACKAGE=
# LAKEHOUSE_JDBC_POSTGRES_PACKAGE=
# LAKEHOUSE_JDBC_SQLSERVER_PACKAGE=

# Query limits
# LAKEHOUSE_MAX_RESULT_ROWS=1000
# LAKEHOUSE_QUERY_TIMEOUT_SECONDS=300

# Physical storage explorer
# LAKEHOUSE_STORAGE_MAX_ENTRIES=5000
# LAKEHOUSE_STORAGE_MAX_DEPTH=6
# Maximum bytes returned by the read-only file preview (default 2 MB).
# LAKEHOUSE_STORAGE_PREVIEW_MAX_BYTES=2097152

# Extra Spark conf, semicolon-separated: key=value;key=value
# LAKEHOUSE_SPARK_EXTRA_OPTIONS=spark.sql.ansi.enabled=true

# Application and API
# LAKEHOUSE_APP_NAME=Open Lakehouse Workbench
# LAKEHOUSE_API_PREFIX=/api
# JSON list of browser origins allowed by CORS (defaults cover 5173/5174/4173/4174 on localhost and 127.0.0.1).
# LAKEHOUSE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Spark extras
# LAKEHOUSE_SPARK_APP_NAME=OpenLakehouseWorkbench
# LAKEHOUSE_SPARK_LOG_LEVEL=WARN
# Spark temp files and run folders for Java/Scala programs and kernels. Defaults to <repo>/.spark_tmp.
# LAKEHOUSE_SPARK_LOCAL_DIR=C:/lakehouse/.spark_tmp

# Storage explorer depth limit (default 6)
# LAKEHOUSE_STORAGE_MAX_DEPTH=6

# Config files (defaults in the repository root)
# LAKEHOUSE_DATABASE_CONFIG_FILE=C:/lakehouse/databases.cfg
# LAKEHOUSE_RUNTIME_SETTINGS_FILE=C:/lakehouse/.runtime_settings.json
